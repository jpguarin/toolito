# Copy to web/.env to override defaults locally (web/.env is git-ignored).
# Where the dryer (/compress-pdf) sends PDFs. Default: the Cloud Run API.
# To use the API running on your computer (uvicorn), uncomment:
# PUBLIC_API_URL=http://localhost:8000

# Public address of the site (canonical URLs, sitemap, Open Graph).
# Default: https://toolito.jpgstudio.net — override only for a different address.
# PUBLIC_SITE_URL=https://toolito.jpgstudio.net
