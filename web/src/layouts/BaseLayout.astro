---
// Minimal shell: styles, fonts and metadata. Header, footer and full SEO
// tags come in the "BaseLayout" task of PLAN.md (stage 4).
import { Font } from "astro:assets";
import { PUBLIC_CF_ANALYTICS_TOKEN } from "astro:env/client";
import Footer from "../components/Footer.astro";
import ShopHeader from "../components/ShopHeader.astro";
import StorefrontHeader from "../components/StorefrontHeader.astro";
import type { Section } from "../lib/nav";
import { DAY_START, NIGHT_START, THEME_COLOR } from "../lib/theme";
import "../styles/global.css";

interface Props {
  title: string; // Becomes "<title> · Toolito" unless it is the home page.
  description: string; // Meta description for search results.
  section?: Section; // Highlights the current link in the header.
  storefront?: boolean; // Home page only: full awning instead of ShopHeader.
  noindex?: boolean; // Keep search engines away (dev and test pages).
}

const { title, description, section, storefront = false, noindex = false } = Astro.props;

// Complete URLs for search engines and link previews (site comes from astro.config.mjs).
// Pages are built as files (merge-pdf.html) but served at /merge-pdf: drop the
// extension (and "index") so the canonical matches the sitemap and the links.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "");
const canonical = new URL(path, Astro.site).href;
const socialImage = new URL("/social-card.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!--
      Pick the theme before the first paint (no flash of the wrong theme).
      Mirrors resolveTheme() in src/lib/theme.ts; the hours come from there.
      ?theme=light|dark is a test-only override: never saved, never linked.
    -->
    <meta name="theme-color" content={THEME_COLOR.light} />
    <script is:inline define:vars={{ DAY_START, NIGHT_START, THEME_COLOR }}>
      var hour = new Date().getHours();
      var theme = hour >= DAY_START && hour < NIGHT_START ? "light" : "dark";
      var forced = new URLSearchParams(location.search).get("theme");
      if (forced === "light" || forced === "dark") theme = forced;
      document.documentElement.dataset.theme = theme;
      // The browser bar follows the theme too (docs/THEMES.md §6).
      document.querySelector('meta[name="theme-color"]').content = THEME_COLOR[theme];
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <!-- Google Search Console ownership check (URL-prefix property). Public by design. -->
    <meta name="google-site-verification" content="QPkvItkH11nCeJLjOftwNPobarsL_YXL3PKn-TPh-Wk" />
    <!-- Link previews (Open Graph, also read by X/Twitter). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Toolito Laundromat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Toolito laundromat: a striped awning over a washing machine porthole full of laundry." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      // Cookie-free visit counter (Privacy Policy §5, House rules). Only when the
      // production token is set; is:inline keeps Cloudflare's tag exactly as is.
      PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_ANALYTICS_TOKEN })}
        />
      )
    }
    <!-- Self-hosted brand fonts (configured in astro.config.mjs). -->
    <Font cssVariable="--font-bungee" preload />
    <Font cssVariable="--font-work-sans" preload />
    <Font cssVariable="--font-caveat" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="label sr-only rounded-sm bg-accent p-3 text-on-accent focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    {storefront ? <StorefrontHeader /> : <ShopHeader current={section} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/live-theme";
      import "../scripts/register-sw";
    </script>
  </body>
</html>
