---
import HouseRules from "../components/HouseRules.astro";
import MachineCard from "../components/MachineCard.astro";
import NoticeBoard from "../components/NoticeBoard.astro";
import Storefront from "../components/Storefront.astro";
import { MACHINES } from "../lib/machines";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Toolito Laundromat — free image and PDF tools"
  description="Compress and convert images, merge, split and compress PDFs. Free, no sign-up, and most tools run on your own device."
  storefront
>
  <Storefront />

  <section aria-labelledby="machines-title" class="mx-auto w-full max-w-page px-5 pb-7">
    <h2 id="machines-title" class="sign-lg mb-5 text-ink">Choose a machine</h2>
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(var(--machine-card-min),1fr))] gap-5">
      {MACHINES.map((machine) => (
        <li class="flex"><MachineCard machine={machine} /></li>
      ))}
    </ul>
  </section>

  <div class="mx-auto grid w-full max-w-page gap-5 px-5 pb-7 lg:grid-cols-[1fr_auto]">
    <HouseRules />
    <NoticeBoard />
  </div>
</BaseLayout>
