---
// TEMPORARY: tries the image engine (jSquash in a worker) before the washer UI
// exists. Delete it when /compress-image is built (stage 5).
import Dropzone from "../../components/Dropzone.astro";
import ChevronDownIcon from "../../icons/chevron-down.svg";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Washer engine playground · Toolito" description="Developer test page." noindex>
  <div class="mx-auto flex w-full max-w-page flex-col gap-5 p-5">
    <h1 class="title">Washer engine playground</h1>
    <label class="label flex items-center gap-3">
      Output
      <!-- appearance-none hides the native arrow (glued to the edge); ours sits inside the padding. -->
      <span class="relative">
        <select class="body appearance-none rounded-sm border-md border-line bg-paper py-2 pr-6 pl-2 text-ink" data-format>
          <option value="webp">WebP</option>
          <option value="avif">AVIF</option>
          <option value="jpeg">JPG</option>
          <option value="png">PNG</option>
          <option value="same">Same</option>
        </select>
        <ChevronDownIcon class="pointer-events-none absolute top-1/2 right-2 -translate-y-1/2" width="16" height="16" stroke="currentColor" aria-hidden="true" />
      </span>
    </label>
    <Dropzone title="Drop images in the washer" hint="JPG, PNG, WebP, AVIF" accept="image/jpeg,image/png,image/webp,image/avif" multiple />
    <ul class="body flex flex-col gap-2 rounded-md border-md border-line bg-card p-5" data-results></ul>
  </div>
</BaseLayout>

<script>
  import { formatBytes } from "../../lib/format";
  import { DEFAULT_SETTINGS, type OutputFormat, formatFromMime, outputName } from "../../lib/image";
  import { washInWorker } from "../../lib/image-worker-client";
  import { DROPZONE_EVENT, type DropzoneFilesEvent } from "../../scripts/dropzone";

  const results = document.querySelector<HTMLUListElement>("[data-results]")!;
  const select = document.querySelector<HTMLSelectElement>("[data-format]")!;

  const log = (text: string, link?: { href: string; name: string }) => {
    const item = document.createElement("li");
    item.textContent = text;
    if (link) {
      const a = document.createElement("a");
      a.href = link.href;
      a.download = link.name;
      a.textContent = " Download";
      a.className = "underline";
      item.append(a);
    }
    results.append(item);
  };

  document.addEventListener(DROPZONE_EVENT, async (event) => {
    for (const file of (event as DropzoneFilesEvent).detail) {
      const input = formatFromMime(file.type);
      if (!input) {
        log(`${file.name}: not a JPG, PNG, WebP or AVIF image.`);
        continue;
      }
      const started = performance.now();
      const settings = { ...DEFAULT_SETTINGS, format: select.value as OutputFormat };
      const result = await washInWorker(await file.arrayBuffer(), input, settings);
      const seconds = ((performance.now() - started) / 1000).toFixed(1);
      if (!result.ok) {
        log(`${file.name}: ${result.message}`);
        continue;
      }
      const blob = new Blob([result.bytes], { type: `image/${result.format}` });
      const name = outputName(file.name, result.format);
      log(`${file.name}: ${formatBytes(file.size)} → ${formatBytes(blob.size)} as ${name} (${result.width}×${result.height}, ${seconds}s)`, {
        href: URL.createObjectURL(blob),
        name,
      });
    }
  });
</script>
