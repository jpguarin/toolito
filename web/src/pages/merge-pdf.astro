---
import ToolGuide from "../components/ToolGuide.astro";
import { GUIDES } from "../lib/content";
import FoldStack from "../components/FoldStack.astro";
import ToolIntro from "../components/ToolIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Merge PDF — combine PDF files free, in your browser · Toolito"
  description="Merge PDF files into one, in the order you choose. Free, no sign-up, and nothing is uploaded: the PDFs are combined on your own device."
  section="pdfs"
>
  <ToolIntro
    machine="Folding table No.4"
    title="Merge PDF"
    lead="Stack your PDFs in order, then fold them into one. Folded right here on your device."
  />
  <FoldStack />
  <ToolGuide guide={GUIDES["merge-pdf"]} />
</BaseLayout>
