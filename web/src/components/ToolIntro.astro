---
// Top of every tool page: machine badge, title and one sentence saying what it
// does and where it runs (mockups/TlFold.dc.html, TlWasher.dc.html).
import Badge from "./Badge.astro";

interface Props {
  machine: string; // "Folding table No.4"
  title: string; // "Merge PDF"
  lead: string;
  hot?: boolean; // The dryer only.
}

const { machine, title, lead, hot = false } = Astro.props;
---

<section class="mx-auto flex w-full max-w-page flex-col gap-2 px-5 pt-7">
  <Badge variant={hot ? "hot" : "machine"}>{machine}</Badge>
  <h1 class="heading wide:title">{title}</h1>
  <p class="body text-muted wide:lead">{lead}</p>
</section>
