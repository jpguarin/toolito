---
// Bottom bar of every page (design/components/Footer.md).
const year = new Date().getFullYear(); // Computed when the site is built.

const links = [
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="border-t-md border-line bg-panel text-panel-ink">
  <div class="caption mx-auto flex max-w-page flex-col gap-3 p-5 wide:flex-row wide:items-center wide:justify-between">
    <span>© {year} Toolito · Little tools, big results.</span>
    <nav aria-label="Footer" class="flex flex-wrap gap-4">
      {links.map(({ label, href }) => <a href={href} class="text-panel-ink underline">{label}</a>)}
    </nav>
  </div>
</footer>
