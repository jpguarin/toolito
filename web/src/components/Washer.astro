---
// Washer No.1 (compress) and No.2 (convert), from mockups/TlWasher.dc.html: the
// machine with its controls, drum and dropzone on one side; the loads and the
// summary on the other. Rows are built from the <template> below (FileRow.md).
// The /jpg-to-webp style pages reuse it with a fixed input and output.
import CloseIcon from "../icons/close.svg";
import DownloadIcon from "../icons/download.svg";
import { ALL_FORMATS, FORMAT_LABEL, formatList, type ImageFormat, MIME, type OutputFormat } from "../lib/image";
import Dropzone from "./Dropzone.astro";
import Porthole from "./Porthole.astro";
import WasherControls from "./WasherControls.astro";

interface Props {
  machine?: "image" | "convert";
  format?: OutputFormat; // Output selected when the page opens.
  accepts?: ImageFormat[]; // Input formats this page takes.
}

const { machine = "image", accepts = ALL_FORMATS } = Astro.props;
const converting = machine === "convert";
const format = Astro.props.format ?? "webp";
const number = converting ? 2 : 1;
const accept = accepts.map((type) => MIME[type]).join(",");
const formats = formatList(accepts);
const noun = accepts.length === 1 ? `${FORMAT_LABEL[accepts[0]]} images` : "images";
const iconButton = "flex size-tap shrink-0 items-center justify-center rounded-pill border-thin border-line text-ink";
---

<div data-washer data-machine={machine} data-accepts={accepts.join(",")} data-default-format={format} class="mx-auto grid w-full max-w-page items-start gap-6 px-5 pt-5 pb-8 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
  <section aria-label={`Washer No.${number}`} class="overflow-hidden rounded-xl border-thick border-line bg-surface">
    <WasherControls number={number} includeSame={!converting} format={format} />
    <div class="flex flex-col items-center gap-5 p-6">
      <Porthole machine={machine} size="lg" laundry />
      <div class="w-full" data-washer-empty>
        <Dropzone title={`Drop ${noun} in the washer`} hint={`or tap to choose · ${formats}`} accept={accept} multiple />
      </div>
      <div class="w-full" data-washer-more hidden>
        <Dropzone title="Add more to the drum" hint={formats} accept={accept} multiple compact />
      </div>
      <button type="button" class="label min-h-tap w-full rounded-pill border-md border-line px-5 text-ink" data-washer-rewash hidden>
        Rewash with new settings
      </button>
    </div>
  </section>

  <div class="flex flex-col gap-4">
    <section aria-labelledby="washer-summary-title" class="flex flex-wrap items-center justify-between gap-4 rounded-lg border-thick border-ok bg-paper p-5" data-washer-summary hidden>
      <div>
        <p class="sign-sm text-heading">{converting ? "Freshly dyed" : "Clean load"}</p>
        <h2 id="washer-summary-title" class="heading" data-washer-saved></h2>
        <p class="label text-muted" data-washer-totals></p>
      </div>
      <a class="label flex min-h-tap items-center gap-3 rounded-pill bg-btn px-5 py-3 text-on-btn no-underline" data-washer-download-all>
        <DownloadIcon width="20" height="20" stroke="currentColor" aria-hidden="true" />
        <span data-washer-download-all-label>Take all home (ZIP)</span>
      </a>
    </section>

    <p class="body rounded-md border-md border-dashed border-line bg-paper p-5 text-muted" data-washer-placeholder>
      {converting ? "Dyed loads" : "Clean loads"} come out here. Everything is washed on your device — nothing leaves the building.
    </p>
    <ul class="flex flex-col gap-3" data-washer-list></ul>
  </div>

  <p class="sr-only" aria-live="polite" data-washer-announce></p>
</div>

<template data-washer-row>
  <li class="flex items-center gap-4 rounded-md border-md border-line bg-card px-4 py-3 data-washing:border-dashed">
    <img class="size-thumb shrink-0 rounded-sm border-thin border-line object-cover" alt="" data-thumb />
    <!-- Phones: thumbnail | (text over actions). From "wide" up the wrappers vanish and everything sits in one row. -->
    <div class="flex min-w-0 flex-1 flex-col gap-3 wide:contents">
      <div class="flex min-w-0 flex-col gap-1 wide:flex-1">
        <p class="label truncate" data-name></p>
        <p class="caption text-muted" data-meta></p>
        <div class="flex items-center gap-3" data-progress hidden>
          <div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuetext="Washing" class="relative h-3 flex-1 overflow-hidden rounded-pill border-thin border-line bg-bg">
            <span class="progress-slide absolute inset-y-0 left-0 w-2/5 bg-accent [box-shadow:var(--glow-accent)]"></span>
          </div>
          <span class="caption font-extrabold">Spinning…</span>
        </div>
        <p class="caption font-extrabold text-error" data-error hidden></p>
      </div>
      <div class="flex items-center gap-3 wide:contents">
        <span class="sign-sm rounded-sm bg-ok px-3 py-2 text-on-ok" data-badge hidden></span>
        <a class={iconButton} data-download hidden><DownloadIcon width="18" height="18" stroke="currentColor" aria-hidden="true" /></a>
        <button type="button" class={iconButton} data-remove><CloseIcon width="16" height="16" stroke="currentColor" aria-hidden="true" /></button>
      </div>
    </div>
  </li>
</template>

<script>
  import { initWasher } from "../scripts/washer";

  const root = document.querySelector<HTMLElement>("[data-washer]");
  const template = document.querySelector<HTMLTemplateElement>("template[data-washer-row]");
  if (root && template) initWasher(root, template);
</script>
