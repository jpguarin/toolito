---
// Home page hero (design/components/Storefront.md): the big TOOLITO /
// LAUNDROMAT sign, the headline and the lead. The awning lives in
// StorefrontHeader, so the hero can sit inside <main>.
---

<section class="mx-auto flex max-w-page flex-col items-center gap-4 px-5 pt-6 pb-7 text-center">
  <div class="rounded-lg border-thick border-sign-border bg-panel px-7 py-5 shadow-sign">
    <p class="sign-lg text-accent [text-shadow:var(--glow-sign)] wide:sign-xl">TOOLITO</p>
    <p class="sign-sm tracking-sign text-sign-sub [text-shadow:var(--glow-led)] wide:sign-md wide:tracking-sign-lg">LAUNDROMAT</p>
  </div>
  <h1 class="heading mt-3 max-w-headline wide:display">We shrink your files. On purpose.</h1>
  <p class="lead max-w-lead text-muted">
    Toss in heavy images and PDFs, pick a cycle, take them home lighter. Every machine is free, day or night.
  </p>
</section>
