---
// The merge tool's folding table (design/components/FoldStack.md): PDFs as
// folded towels in order, reorder controls, and "the pile" preview.
// Rows are built in the browser from the <template> below.
import ArrowDownIcon from "../icons/arrow-down.svg";
import ArrowUpIcon from "../icons/arrow-up.svg";
import CloseIcon from "../icons/close.svg";
import DownloadIcon from "../icons/download.svg";
import Dropzone from "./Dropzone.astro";

const iconButton =
  "flex size-tap shrink-0 items-center justify-center rounded-pill border-thin border-line text-ink " +
  "disabled:cursor-default disabled:border-rim disabled:text-muted";
---

<div data-fold-stack class="mx-auto grid w-full max-w-page gap-6 px-5 pt-5 pb-8 lg:grid-cols-[1fr_var(--ad-rect-width)]">
  <section aria-labelledby="table-title" class="wood-table flex flex-col gap-3 rounded-lg border-thick border-line p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="table-title" class="sign-md rounded-sm bg-paper px-3 py-1">The table</h2>
      <p class="label rounded-sm bg-paper px-3 py-1" data-fold-hint hidden>Use the arrows to reorder</p>
    </div>

    <div data-fold-empty>
      <Dropzone title="Drop your PDFs on the table" hint="or tap to choose · as many as you like" accept="application/pdf" multiple />
    </div>
    <ol class="flex flex-col gap-3" data-fold-list></ol>
    <div data-fold-more hidden>
      <Dropzone title="Add another PDF to the table" hint="PDF only" accept="application/pdf" multiple compact />
    </div>
    <ul class="caption flex flex-col gap-1 rounded-sm bg-paper p-3 text-error" data-fold-errors hidden></ul>
  </section>

  <aside aria-labelledby="pile-title" class="flex flex-col gap-5 self-start rounded-lg border-thick border-line bg-paper p-5">
    <h2 id="pile-title" class="sign-md">The pile</h2>
    <div class="flex flex-col gap-1 px-6" aria-hidden="true" data-fold-pile></div>
    <p class="body">
      <strong data-fold-summary>The table is empty</strong><br />
      <span class="text-muted">Top of the pile = first pages</span>
    </p>
    <button
      type="button"
      class="sign-md min-h-tap rounded-pill border-thick border-line bg-accent px-5 py-3 text-on-accent [box-shadow:var(--glow-accent)] disabled:cursor-default disabled:border-rim disabled:bg-transparent disabled:text-muted disabled:shadow-none"
      data-fold-button
      disabled
    >
      Fold into one
    </button>
    <p class="caption text-muted" data-fold-why>Add at least two PDFs to fold them.</p>
    <div class="flex flex-col gap-3" data-fold-result hidden>
      <p class="body"><strong>Folded!</strong> <span class="text-muted" data-fold-result-meta></span></p>
      <a
        class="label flex min-h-tap items-center justify-center gap-3 rounded-pill bg-btn px-5 py-3 text-on-btn no-underline"
        download="merged.pdf"
        data-fold-download
      >
        <DownloadIcon width="20" height="20" stroke="currentColor" aria-hidden="true" />
        Take it home
      </a>
    </div>
    <p class="caption text-muted">Nothing is uploaded. The table is in your browser.</p>
  </aside>

  <!-- Screen readers hear reorder results here (FoldStack.md: announce the new position). -->
  <p class="sr-only" aria-live="polite" data-fold-announce></p>
</div>

<template data-fold-row>
  <li
    tabindex="0"
    class="flex items-center gap-4 overflow-hidden rounded-md border-md border-line bg-paper pr-3 focus-visible:outline-[length:var(--border-thick)] focus-visible:outline-offset-[var(--border-thin)] focus-visible:outline-accent"
  >
    <span class="towel self-stretch" aria-hidden="true" data-towel></span>
    <span class="sign-md w-6 shrink-0" data-number></span>
    <div class="min-w-0 flex-1 py-3">
      <p class="label truncate" data-name></p>
      <p class="caption text-muted" data-meta></p>
    </div>
    <button type="button" class={iconButton} data-up><ArrowUpIcon width="20" height="20" stroke="currentColor" aria-hidden="true" /></button>
    <button type="button" class={iconButton} data-down><ArrowDownIcon width="20" height="20" stroke="currentColor" aria-hidden="true" /></button>
    <button type="button" class={iconButton} data-remove><CloseIcon width="18" height="18" stroke="currentColor" aria-hidden="true" /></button>
  </li>
</template>

<script>
  import { initFoldStack } from "../scripts/fold-stack";

  const root = document.querySelector<HTMLElement>("[data-fold-stack]");
  const template = document.querySelector<HTMLTemplateElement>("template[data-fold-row]");
  if (root && template) initFoldStack(root, template);
</script>
