---
// "Popular conversions": links to every /from-to-to page, so people (and
// search engines) can reach each one from the converter.
import { CONVERSIONS } from "../lib/conversions";
---

<nav aria-labelledby="conversions-title" class="mx-auto w-full max-w-page px-5 pb-8">
  <h2 id="conversions-title" class="sign-md mb-4">Popular conversions</h2>
  <ul class="flex flex-wrap gap-3">
    {CONVERSIONS.map(({ slug, title }) => (
      <li>
        <a href={`/${slug}`} class="label flex min-h-tap items-center rounded-pill border-md border-line bg-paper px-4 text-ink no-underline">
          {title}
        </a>
      </li>
    ))}
  </ul>
</nav>
