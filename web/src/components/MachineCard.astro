---
// One tool as a laundromat machine (design/components/MachineCard.md). The
// whole card is one link. The dryer is the only server tool: it gets the
// "hot" style, which nothing else may use.
import type { Machine } from "../lib/machines";
import LedDisplay from "./LedDisplay.astro";
import Porthole from "./Porthole.astro";

interface Props {
  machine: Machine;
}

const { machine } = Astro.props;
const hot = machine.id === "dryer";
---

<a
  href={machine.href}
  class:list={[
    "flex w-full flex-col overflow-hidden rounded-lg border-thick text-center no-underline",
    hot ? "border-hot bg-paper text-ink shadow-hot" : "border-line bg-surface text-ink",
  ]}
>
  <div
    class:list={[
      "flex items-center justify-between px-4 py-3",
      hot ? "bg-hot text-on-hot" : "bg-panel text-panel-ink",
    ]}
  >
    <span class="sign-md">No.{machine.number}</span>
    <LedDisplay text={machine.tag} tone={hot ? "hot" : "led"} />
  </div>
  <div class="flex flex-1 flex-col items-center gap-2 p-5">
    <Porthole machine={machine.id} />
    <span class="card-title mt-3">{machine.title}</span>
    <span class="caption text-muted">{machine.line}</span>
  </div>
</a>
