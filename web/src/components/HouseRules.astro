---
// The privacy promise as the shop's posted rules (design/components/HouseRules.md).
// Keep the wording in sync with the Privacy page, and never promise more than
// the code does: if analytics are added, add a rule.
const rules = [
  ["We never look in your basket.", "Images, merging and splitting happen on your own device."],
  ["Nothing gets left behind.", "The dryer (PDF compression) runs on our machine and is emptied after every load."],
  ["No coins needed.", "Everything here is free. No sign-up, no watermarks."],
  ["Lights follow the clock.", "After 7 p.m. your time, the shop switches to its night lights."],
];
---

<section id="house-rules" aria-labelledby="house-rules-title" class="flex flex-col gap-3 rounded-md border-thick border-line bg-paper p-6">
  <h2 id="house-rules-title" class="sign-lg text-heading">House rules</h2>
  <ol class="body flex list-decimal flex-col gap-2 pl-5">
    {rules.map(([promise, detail]) => (
      <li><strong>{promise}</strong> {detail}</li>
    ))}
  </ol>
  <p class="caption text-muted">— The management</p>
</section>
